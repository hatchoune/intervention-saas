# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe to expose to the browser, RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never
# import the admin client from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used for invitation links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: display name used in transactional e-mails / UI fallbacks.
NEXT_PUBLIC_APP_NAME=FieldFlow
